# CostRouter — .env.example
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.
#
# The costrouter library never reads API keys. benchmark/run.py reads the
# provider key below and hands it straight to the provider client (it is never
# logged or stored). LangChain provider packages read their own variables.

# benchmark/run.py uses the first of these that is set (or pass --provider).
GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...

# Optional: SQLite database path used by the dashboard (defaults to ./costrouter.db)
COSTROUTER_DB_PATH=./costrouter.db

# Optional: JMeter install used by jmeter/run_tests.py
JMETER_HOME=C:\path\to\apache-jmeter-5.6.3
