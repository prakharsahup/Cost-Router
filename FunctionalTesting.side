  "suites": [
    {
      "id": "suite-001-auth",
      "name": "Authentication Tests",
      "persistSession": false,
      "parallel": false,
      "timeout": 30,
      "tests": [
        "test-001-login-valid",
        "test-002-login-invalid",
        "test-003-logout"
      ]
    },
    {
      "id": "suite-002-ui",
      "name": "UI Interaction Tests",
      "persistSession": false,
      "parallel": false,
      "timeout": 30,
      "tests": [
        "test-004-checkboxes",
        "test-005-dropdown",
        "test-006-add-remove-elements"
      ]
    },
    {
      "id": "suite-003-advanced",
      "name": "Advanced Interaction Tests",
      "persistSession": false,
      "parallel": false,
      "timeout": 30,
      "tests": [
        "test-007-javascript-alerts",
        "test-008-hover",
        "test-009-dynamic-loading",
        "test-010-key-presses"
      ]
    }
  ],
  "urls": [
