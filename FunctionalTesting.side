    {
      "id": "test-004-checkboxes",
      "name": "TC04 - Checkboxes Toggle",
      "commands": [
        {
          "id": "cmd-0401",
          "command": "open",
          "target": "/checkboxes",
          "targets": [],
          "value": "",
          "comment": "Navigate to checkboxes page"
        },
        {
          "id": "cmd-0402",
          "command": "assertElementPresent",
          "target": "css=#checkboxes input:nth-child(1)",
          "targets": [],
          "value": "",
          "comment": "Verify first checkbox exists"
        },
        {
          "id": "cmd-0403",
          "command": "assertElementPresent",
          "target": "css=#checkboxes input:nth-child(3)",
          "targets": [],
          "value": "",
          "comment": "Verify second checkbox exists"
        },
        {
          "id": "cmd-0404",
          "command": "assertNotChecked",
          "target": "css=#checkboxes input:nth-child(1)",
          "targets": [],
          "value": "",
          "comment": "Verify first checkbox is unchecked by default"
        },
        {
          "id": "cmd-0405",
          "command": "assertChecked",
          "target": "css=#checkboxes input:nth-child(3)",
          "targets": [],
          "value": "",
          "comment": "Verify second checkbox is checked by default"
        },
        {
          "id": "cmd-0406",
          "command": "click",
          "target": "css=#checkboxes input:nth-child(1)",
          "targets": [],
          "value": "",
          "comment": "Toggle first checkbox ON"
        },
        {
          "id": "cmd-0407",
          "command": "assertChecked",
          "target": "css=#checkboxes input:nth-child(1)",
          "targets": [],
          "value": "",
          "comment": "Verify first checkbox is now checked"
        },
        {
          "id": "cmd-0408",
          "command": "click",
          "target": "css=#checkboxes input:nth-child(3)",
          "targets": [],
          "value": "",
          "comment": "Toggle second checkbox OFF"
        },
        {
          "id": "cmd-0409",
          "command": "assertNotChecked",
          "target": "css=#checkboxes input:nth-child(3)",
          "targets": [],
          "value": "",
          "comment": "Verify second checkbox is now unchecked"
        }
      ]
    },
    {
      "id": "test-005-dropdown",
      "name": "TC05 - Dropdown Selection",
      "commands": [
        {
          "id": "cmd-0501",
          "command": "open",
          "target": "/dropdown",
          "targets": [],
          "value": "",
          "comment": "Navigate to dropdown page"
        },
        {
          "id": "cmd-0502",
