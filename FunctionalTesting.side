          "targets": [],
          "value": "",
          "comment": "Verify dropdown element is present"
        },
        {
          "id": "cmd-0503",
          "command": "select",
          "target": "id=dropdown",
          "targets": [
            [
              "id=dropdown",
              "id"
            ]
          ],
          "value": "label=Option 1",
          "comment": "Select Option 1 from dropdown"
        },
        {
          "id": "cmd-0504",
          "command": "assertSelectedValue",
          "target": "id=dropdown",
          "targets": [],
          "value": "1",
          "comment": "Verify Option 1 is selected (value=1)"
        },
        {
          "id": "cmd-0505",
          "command": "select",
          "target": "id=dropdown",
          "targets": [
            [
              "id=dropdown",
              "id"
            ]
          ],
          "value": "label=Option 2",
          "comment": "Select Option 2 from dropdown"
        },
        {
          "id": "cmd-0506",
          "command": "assertSelectedValue",
          "target": "id=dropdown",
          "targets": [],
          "value": "2",
          "comment": "Verify Option 2 is selected (value=2)"
        },
        {
          "id": "cmd-0507",
          "command": "assertSelectedLabel",
          "target": "id=dropdown",
          "targets": [],
          "value": "Option 2",
          "comment": "Verify the visible label is Option 2"
        }
      ]
    },
    {
      "id": "test-006-add-remove-elements",
      "name": "TC06 - Add/Remove Elements",
      "commands": [
        {
          "id": "cmd-0601",
          "command": "open",
          "target": "/add_remove_elements/",
          "targets": [],
          "value": "",
          "comment": "Navigate to Add/Remove Elements page"
        },
        {
          "id": "cmd-0602",
          "command": "assertText",
          "target": "css=h3",
          "targets": [],
          "value": "Add/Remove Elements",
          "comment": "Verify page heading"
        },
        {
          "id": "cmd-0603",
          "command": "click",
          "target": "css=button[onclick='addElement()']",
          "targets": [],
          "value": "",
          "comment": "Click Add Element button"
        },
        {
          "id": "cmd-0604",
          "command": "assertElementPresent",
          "target": "css=#elements .added-manually",
          "targets": [],
          "value": "",
          "comment": "Verify a Delete button appeared"
        },
        {
          "id": "cmd-0605",
          "command": "click",
          "target": "css=button[onclick='addElement()']",
          "targets": [],
          "value": "",
          "comment": "Click Add Element button again"
        },
        {
          "id": "cmd-0606",
          "command": "assertElementPresent",
          "target": "css=#elements .added-manually:nth-child(2)",
          "targets": [],
          "value": "",
          "comment": "Verify second Delete button appeared"
        },
        {
          "id": "cmd-0607",
          "command": "click",
          "target": "css=#elements .added-manually:nth-child(1)",
          "targets": [],
          "value": "",
          "comment": "Click first Delete button"
        },
        {
          "id": "cmd-0608",
          "command": "executeScript",
          "target": "return document.querySelectorAll('#elements .added-manually').length",
          "targets": [],
          "value": "deleteCount",
          "comment": "Count remaining delete buttons via JS"
        },
        {
          "id": "cmd-0609",
          "command": "assert",
          "target": "deleteCount",
          "targets": [],
          "value": "1",
          "comment": "Verify only one Delete button remains"
        }
      ]
    },
    {
      "id": "test-007-javascript-alerts",
      "name": "TC07 - JavaScript Alerts",
      "commands": [
        {
          "id": "cmd-0701",
          "command": "open",
          "target": "/javascript_alerts",
          "targets": [],
          "value": "",
          "comment": "Navigate to JavaScript Alerts page"
        },
        {
          "id": "cmd-0702",
          "command": "assertText",
          "target": "css=h3",
          "targets": [],
