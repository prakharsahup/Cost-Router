{
  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "version": "2.0",
  "name": "FunctionalTesting",
  "url": "https://the-internet.herokuapp.com",
  "tests": [
    {
      "id": "test-001-login-valid",
      "name": "TC01 - Valid Login",
      "commands": [
        {
          "id": "cmd-0101",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": "",
          "comment": "Navigate to the login page"
        },
        {
          "id": "cmd-0102",
          "command": "assertTitle",
          "target": "The Internet",
          "targets": [],
          "value": "",
          "comment": "Verify page title"
        },
        {
          "id": "cmd-0103",
          "command": "assertElementPresent",
          "target": "id=username",
          "targets": [],
          "value": "",
          "comment": "Verify username field is present"
        },
        {
          "id": "cmd-0104",
          "command": "assertElementPresent",
          "target": "id=password",
          "targets": [],
          "value": "",
          "comment": "Verify password field is present"
        },
        {
          "id": "cmd-0105",
          "command": "type",
          "target": "id=username",
          "targets": [
            [
              "id=username",
              "id"
            ]
          ],
          "value": "tomsmith",
          "comment": "Enter valid username"
        },
        {
          "id": "cmd-0106",
          "command": "type",
          "target": "id=password",
          "targets": [
            [
              "id=password",
              "id"
            ]
          ],
          "value": "SuperSecretPassword!",
          "comment": "Enter valid password"
        },
        {
          "id": "cmd-0107",
          "command": "click",
          "target": "css=button[type='submit']",
          "targets": [
            [
              "css=button[type='submit']",
              "css"
            ]
          ],
          "value": "",
          "comment": "Click the Login button"
        },
        {
          "id": "cmd-0108",
          "command": "waitForElementVisible",
          "target": "id=flash",
          "targets": [],
          "value": "5000",
          "comment": "Wait for flash message to appear"
        },
        {
          "id": "cmd-0109",
          "command": "assertElementPresent",
          "target": "xpath=//div[@id='flash'][contains(.,'You logged into a secure area!')]",
          "targets": [],
          "value": "",
          "comment": "Verify success flash message"
        },
        {
          "id": "cmd-0110",
          "command": "assertElementPresent",
          "target": "css=a[href='/logout']",
          "targets": [],
          "value": "",
          "comment": "Verify Logout button is present on secure page"
        }
      ]
    },
