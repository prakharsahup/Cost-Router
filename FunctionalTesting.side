          "comment": "Verify page heading"
        },
        {
          "id": "cmd-0703",
          "command": "executeScript",
          "target": "window.alert = () => true",
          "targets": [],
          "value": "",
          "comment": "Mock alert to auto-accept"
        },
        {
          "id": "cmd-0704",
          "command": "click",
          "target": "css=button[onclick='jsAlert()']",
          "targets": [],
          "value": "",
          "comment": "Click JS Alert button"
        },
        {
          "id": "cmd-0705",
          "command": "assertText",
          "target": "id=result",
          "targets": [],
          "value": "You successfully clicked an alert",
          "comment": "Verify result text after alert"
        },
        {
          "id": "cmd-0706",
          "command": "executeScript",
          "target": "window.confirm = () => true",
          "targets": [],
          "value": "",
          "comment": "Mock confirm to return true (Ok)"
        },
        {
          "id": "cmd-0707",
          "command": "click",
          "target": "css=button[onclick='jsConfirm()']",
          "targets": [],
          "value": "",
          "comment": "Click JS Confirm button"
        },
        {
          "id": "cmd-0708",
          "command": "assertText",
          "target": "id=result",
          "targets": [],
          "value": "You clicked: Ok",
          "comment": "Verify result after accepting confirmation"
        },
        {
          "id": "cmd-0709",
          "command": "executeScript",
          "target": "window.prompt = () => 'Selenium Test Input'",
          "targets": [],
          "value": "",
          "comment": "Mock prompt to return test input"
        },
        {
          "id": "cmd-0710",
          "command": "click",
          "target": "css=button[onclick='jsPrompt()']",
          "targets": [],
          "value": "",
          "comment": "Click JS Prompt button"
        },
        {
          "id": "cmd-0711",
          "command": "assertText",
          "target": "id=result",
          "targets": [],
          "value": "You entered: Selenium Test Input",
          "comment": "Verify result shows entered prompt text"
        }
      ]
    },
